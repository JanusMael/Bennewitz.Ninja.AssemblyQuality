<Project Sdk="Microsoft.NET.Sdk">
  <!-- Declares its own InternalsVisibleTo grants, three of them deliberately wrong, as BNAQ1005's
       subject. It opts out of the family's solution-wide grants (Templates plan 00006), as every
       fixture does: the shared grant file would otherwise grant it everything and hide the cases
       under test. -->
  <PropertyGroup>
    <AssemblyName>AssemblyQuality.Fixtures.Granting</AssemblyName>
    <SolutionFriendGrants>false</SolutionFriendGrants>
  </PropertyGroup>
</Project>
